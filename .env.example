# ==============================================================================
# ORCA: Marine Mission Intelligence Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file to '.env' before running the application.
# 2. Never commit actual secret keys or credentials to version control.
# 3. Local demo uses deterministic SNAPSHOT data and requires no live APIs.
# ==============================================================================

# Application Environment
APP_NAME=ORCA
APP_ENV=development # development | staging | demo | production
DEBUG=true
LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
NEXTJS_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Database (PostgreSQL + PostGIS)
# Local: use the Docker Compose PostGIS service below.
# Render production: Render injects DATABASE_URL from the managed PostgreSQL
# database. Never commit the real value or credentials.
# PostGIS must be enabled on the database; the backend is the only DB client.
POSTGRES_USER=orca_user
POSTGRES_PASSWORD=orca_password_placeholder
POSTGRES_DB=orca_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orca_user:orca_password_placeholder@localhost:5432/orca_db
SYNC_DATABASE_URL=postgresql+psycopg2://orca_user:orca_password_placeholder@localhost:5432/orca_db
# Render normally needs only DATABASE_URL; SYNC_DATABASE_URL is derived unless
# an explicit migration/driver-specific override is required.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# ALEMBIC_DATABASE_URL=

# Data Ingestion & Strategy
# Modes:
#   LIVE     - Always query live external endpoints (fails if offline/rate-limited)
#   HYBRID   - Try live endpoints first; gracefully fallback to snapshot fixtures (RECOMMENDED FOR SIH)
#   SNAPSHOT - Fully offline deterministic fixtures (guaranteed reproducible for judge demos)
DATA_MODE=SNAPSHOT
DATA_FIXTURES_PATH=./data/fixtures

# External Marine & Weather API Endpoints / Keys (Placeholders)
INCOIS_API_BASE_URL=https://incois.gov.in/portal/rest/placeholder
INCOIS_API_KEY=your_incois_api_key_here
IMD_API_BASE_URL=https://mausam.imd.gov.in/api/placeholder
IMD_API_KEY=your_imd_api_key_here
MOSDAC_API_BASE_URL=https://mosdac.gov.in/api/placeholder
MOSDAC_API_KEY=your_mosdac_api_key_here
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_CACHE_TTL_SECONDS=3600

# LLM Provider Configuration (Provider-Agnostic LangGraph Interface)
# Supported provider placeholders: groq | openai | anthropic | gemini | ollama | fake
LLM_MODE=auto # auto | deterministic | fake | provider
LLM_PROVIDER=groq # groq | openai | ollama | fake
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=25

# Map / Geospatial Configuration
MAPLIBRE_DEFAULT_CENTER_LON=72.8777
MAPLIBRE_DEFAULT_CENTER_LAT=19.0760
MAPLIBRE_DEFAULT_ZOOM=6
BASEMAP_STYLE_URL=https://demotiles.maplibre.org/style.json
